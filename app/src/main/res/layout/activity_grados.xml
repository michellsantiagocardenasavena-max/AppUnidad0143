<?xml version="1.0" encoding="utf-8"?>

<RadioGroup
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GradosActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10sp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/titulo"
            android:text="@string/strTituloGrados"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textAlignment="center"
            android:paddingTop="10sp"
            android:paddingBottom="10sp"/>

        <EditText
            android:id="@+id/txtCantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/strCantidad"
            android:paddingTop="10sp"
            android:paddingBottom="10sp"
            android:inputType="numberDecimal"/>

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center">

            <RadioButton
                android:id="@+id/rdCel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/strCel"
                android:layout_gravity="center"
                android:checked="true"
                android:textSize="20sp"/>

            <RadioButton
                android:id="@+id/rdFah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/strFah"
                android:layout_gravity="center"
                android:textSize="20sp"/>

        </RadioGroup>

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10sp"
            android:text="@string/strResultadoG"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textAlignment="center"
            android:paddingTop="10sp"
            android:paddingBottom="10sp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/strCalcularG"/>

            <Button
                android:id="@+id/btnLimpiar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/strLimpiar"/>

            <Button
                android:id="@+id/btnSalir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/strSalir"/>

        </LinearLayout>

    </LinearLayout>

</RadioGroup>