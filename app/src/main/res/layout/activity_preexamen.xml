<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:padding="15dp"
    tools:context=".PreActivity">



    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="30dp"
        android:text="Operaciones Aritmeticas"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Iconos de operaciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/white"
        android:padding="8dp">


        <ImageView
            android:id="@+id/image"
            android:layout_width="399dp"
            android:layout_height="67dp"
            android:layout_marginTop="1dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/strImc"
            android:scaleType="fitCenter"
            android:src="@mipmap/operaciones" />

        <TextView
            android:id="@+id/btnDivision"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="÷"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Espacio -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="45dp" />

    <!-- Nombre -->
    <EditText
        android:id="@+id/txtNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Escribe tu nombre para ingresar"
        android:textColor="@color/black"
        android:textColorHint="#AAAAAA"
        android:textSize="16sp"
        android:background="@color/white"
        android:padding="15dp"
        android:inputType="textPersonName" />

    <!-- Espacio -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Ingresar"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#7052B5" />

        <Button
            android:id="@+id/btnCerrar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Cerrar"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#7052B5" />

    </LinearLayout>

</LinearLayout>