<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CotizacionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strNombreCliente"
            android:textAlignment="center"
            android:textColor="@color/red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="5dp" />

        <TextView
            android:id="@+id/txtFolio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strnumFolio" />

        <EditText
            android:id="@+id/txtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripcion de automovil"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/txtPorcentaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Porcentaje de pago incial"
            android:textAlignment="textEnd"
            android:textSize="15sp"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/txtPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Valor del Automovil"
            android:textAlignment="textEnd"
            android:textSize="15sp"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strPLazos"
            android:textAlignment="center"
            android:textColor="@color/red"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rdb12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str12meses" />

            <RadioButton
                android:id="@+id/rdb24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str24meses" />

            <RadioButton
                android:id="@+id/rdb36"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str36meses" />

            <RadioButton
                android:id="@+id/rdb48"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str48meses" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="5dp">

            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/strCalcular" />

            <Button
                android:id="@+id/btnLimpiar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/strbtnLimpiar" />

            <Button
                android:id="@+id/btnSalir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/strbtnSalir" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cálculos"
            android:textAlignment="center"
            android:textColor="@color/red"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPagoI"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strPagoInicial" />

        <TextView
            android:id="@+id/txtTotalFin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strTotalaFinanciar" />

        <TextView
            android:id="@+id/txtPagoMensual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strMe" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>