<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MonedasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10sp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strCantidadMon"
            android:textAlignment="center"
            android:background="@color/titulo"
            android:textColor="@color/yellow"
            android:textSize="20sp"
            android:textStyle="bold">

        </TextView>
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtCantidad"
            android:paddingTop="10sp"
            android:paddingBottom="10sp"
            android:hint="@string/strCantidadMon"
            android:inputType="numberDecimal">

        </EditText>
        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10sp"
            android:paddingTop="10sp"
            android:paddingBottom="10sp"
            android:id="@+id/spnMonedas">

        </Spinner>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/yellow"
            android:textColor="@color/red"
            android:paddingBottom="10sp"
            android:paddingTop="10sp"
            android:textSize="20sp"
            android:textAlignment="center"
            android:id="@+id/txtResultado">

        </TextView>
        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">

        </Space>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:padding="5sp">

        </LinearLayout>
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strBtnConvertir"
            android:layout_weight="1"
            android:id="@+id/btnConvertir">

        </Button>
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strbtnLimpiar"
            android:layout_weight="1"
            android:id="@+id/btnLimpiar">

        </Button>
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strbtnSalir"
            android:layout_weight="1"
            android:id="@+id/btnSalir">

        </Button>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>