<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="30dp"
        android:paddingBottom="15dp">

        <TextView
            android:id="@+id/lblNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usuario :"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="10dp">
        </TextView>

        <EditText
            android:id="@+id/txtNumCuenta"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/strNumCuentaB"
            android:inputType="text"
            android:textSize="14sp">
        </EditText>

        <EditText
            android:id="@+id/txtNombre"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/strNombreClienteB"
            android:inputType="text"
            android:textSize="14sp">
        </EditText>

        <EditText
            android:id="@+id/txtBanco"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/strBancoB"
            android:inputType="text"
            android:textSize="14sp">
        </EditText>

        <EditText
            android:id="@+id/txtSaldo"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/strSaldoB"
            android:inputType="numberDecimal"
            android:textSize="14sp">
        </EditText>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strMovimientos"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="25dp"
            android:paddingBottom="15dp">
        </TextView>

        <Spinner
            android:id="@+id/spnMovimientos"
            android:layout_width="match_parent"
            android:layout_height="45dp">
        </Spinner>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nuevo Saldo $"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="25dp"
            android:paddingBottom="5dp">
        </TextView>

        <TextView
            android:id="@+id/txtNuevoSaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="5dp">
        </TextView>

        <EditText
            android:id="@+id/txtCantidad"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/strCantidadB"
            android:inputType="numberDecimal"
            android:textSize="14sp">
        </EditText>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="20dp">

            <Button
                android:id="@+id/btnRegistrarCuenta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/strRegistrarCuenta"
                android:textSize="11sp">
            </Button>

            <Button
                android:id="@+id/btnAplicarMovimiento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/strAplicarMovimiento"
                android:textSize="11sp">
            </Button>

        </LinearLayout>

    </LinearLayout>

</ScrollView>